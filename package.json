{
  "name": "Lavasecco",
  "productName": "Lavasecco",
  "version": "2.0.0",
  "description": "Applicazione desktop Electron per la gestione ordini, clienti e listino di una lavanderia/lavasecco.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/**/*.test.js\"",
    "test:e2e": "playwright test",
    "test:tutti": "npm test && npm run test:e2e",
    "backup-db": "node scripts/backup-db.js",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gherardiandrea/Lavasecco.git"
  },
  "keywords": [
    "electron",
    "lavasecco",
    "lavanderia",
    "gestione-ordini",
    "sqlite"
  ],
  "author": "Andrea Ghera",
  "license": "CC0-1.0",
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@playwright/test": "^1.63.0",
    "electron": "^44.4.5"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "bootstrap": "^5.3.8",
    "datatables.net": "^1.13.11",
    "datatables.net-bs5": "^1.13.11",
    "electron-squirrel-startup": "^1.0.1",
    "jquery": "^3.7.1"
  },
  "overrides": {
    "@electron/node-gyp": "10.2.0-electron.1"
  },
  "allowScripts": {
    "electron-winstaller": true
  }
}
