{
  "name": "Lavasecco",
  "version": "1.0.0",
  "description": "Applicazione desktop Electron per la gestione ordini, clienti e listino di una lavanderia/lavasecco.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "backup-db": "node scripts/backup-db.js",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "build": {
    "win": {
      "icon": "img/logo_trim.png"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gherardiandrea/Lavasecco.git"
  },
  "keywords": [
    "electron",
    "lavasecco",
    "lavanderia",
    "gestione-ordini",
    "sqlite"
  ],
  "author": "Andrea Ghera",
  "license": "CC0-1.0",
  "devDependencies": {
    "@electron-forge/cli": "^6.0.0-beta.65",
    "@electron-forge/maker-deb": "^6.0.0-beta.65",
    "@electron-forge/maker-rpm": "^6.0.0-beta.65",
    "@electron-forge/maker-squirrel": "^6.0.0-beta.65",
    "@electron-forge/maker-zip": "^6.0.0-beta.65",
    "electron": "^17.1.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.0.0",
    "better-sqlite3": "^8.7.0",
    "bootstrap": "^5.1.3",
    "bootstrap-datepicker": "^1.9.0",
    "datatables.net-bs4": "^1.11.4",
    "electron-squirrel-startup": "^1.0.0",
    "node-require-function": "^1.2.0",
    "popper.js": "^1.16.1",
    "require": "^2.4.20",
    "select2": "^4.1.0-rc.0",
    "select2-bootstrap-theme": "^0.1.0-beta.10"
  },
  "config": {
    "forge": {
      "packagerConfig": {},
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "lavasecco"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ]
    }
  }
}
